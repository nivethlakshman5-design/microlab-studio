{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicroLab Studio",
  "version": "0.1.0",
  "identifier": "studio.microlab.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/configure-native-endpoint.mjs",
    "frontendDist": "../native-shell"
  },
  "app": {
    "windows": [
      {
        "title": "MicroLab Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Interactive electronics and robotics learning studio",
    "longDescription": "MicroLab Studio is a maker workspace for learning electronics, coding, and 3D robotics builds."
  }
}
